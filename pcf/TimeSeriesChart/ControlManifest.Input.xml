    <property name="selectedPointJson" display-name-key="SelectedPointJson_Display_Key" description-key="SelectedPointJson_Desc_Key" of-type="SingleLine.Text" usage="output" required="false" />
    <!--
      Property node's of-type attribute can be of-type-group attribute.
      Example:
      <type-group name="numbers">
        <type>Whole.None</type>
        <type>Currency</type>
        <type>FP</type>
        <type>Decimal</type>
