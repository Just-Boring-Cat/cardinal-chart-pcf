      pfx-default-value='JSON(Table({x:-1,y:0},{x:0,y:1},{x:0.5,y:2},{x:1,y:2},{x:1.5,y:0},{x:2,y:0},{x:2.5,y:-1},{x:3,y:0},{x:3.5,y:2}), JSONFormat.Compact)' />
    <property name="xAxisLabel" display-name-key="XAxisLabel_Display_Key" description-key="XAxisLabel_Desc_Key" of-type="SingleLine.Text" usage="input" required="false" default-value="Seconds" pfx-default-value='"Seconds"' />
