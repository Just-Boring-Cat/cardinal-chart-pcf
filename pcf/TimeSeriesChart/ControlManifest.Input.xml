    <property name="xMax" display-name-key="XMax_Display_Key" description-key="XMax_Desc_Key" of-type="Decimal" usage="input" required="false" pfx-default-value='Blank()' />
    <property name="yMin" display-name-key="YMin_Display_Key" description-key="YMin_Desc_Key" of-type="Decimal" usage="input" required="false" pfx-default-value='Blank()' />
